# Servidor Node.js
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cafeteria_db

# Ollama + Gemma 3
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_MS=45000
CHATBOT_TEMPERATURE=0.4
CHATBOT_MAX_HISTORY=10

# Pexels API (opcional para refresco dinamico via GET /api/media/hero?refresh=true)
PEXELS_API_KEY=
